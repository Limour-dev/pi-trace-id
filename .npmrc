# Host-provided peers (@earendil-works/pi-*) must never be installed: pi bundles
# them and injects them through loader aliases. `optional` in peerDependenciesMeta
# already prevents npm from auto-installing them; this is defence in depth for the
# `pi install git:...` path, which runs plain `npm install` in this clone.
legacy-peer-deps=true

# esbuild publishes 26 prebuilt platform binaries as optionalDependencies
# (~284 MB for a single usable one). Nothing here needs them.
omit=optional
